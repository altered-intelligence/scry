# --- Database ---
# Postgres (production-ish, via docker compose):
CTI_DATABASE_URL=postgresql+psycopg://cti:cti@localhost:5432/cti
# SQLite (zero-infra default for local + tests):
# CTI_DATABASE_URL=sqlite+pysqlite:///./cti.sqlite

# --- App ---
CTI_ENV=local
CTI_LOG_LEVEL=INFO
CTI_API_HOST=0.0.0.0
CTI_API_PORT=8000

# --- Safety defaults (all collection guardrails) ---
CTI_ENABLE_DARK_WEB=false
CTI_ENABLE_JS_RENDERING=false
CTI_ENABLE_FILE_DOWNLOADS=false
CTI_ENABLE_EXPLOIT_REPO_CLONE=false
CTI_ENABLE_OUTBOUND_ALERTS=false
CTI_MAX_FETCH_BYTES=5242880
CTI_FETCH_TIMEOUT_SECONDS=20

# --- Optional LLM (off by default; deterministic extractors used otherwise) ---
CTI_LLM_PROVIDER=stub
# CTI_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- UI ---
# Show the experimental AI chat panel on /ui/search (requires an LLM provider + /static/ai_chat.* assets):
CTI_ENABLE_AI_SEARCH=false

# --- Optional integrations (all stubs by default) ---
CTI_MISP_URL=
CTI_MISP_KEY=
CTI_OPENCTI_URL=
CTI_OPENCTI_KEY=

# --- Enrichment Connectors ---
# VirusTotal & OTX (original connectors)
CTI_VIRUSTOTAL_API_KEY=
CTI_OTX_API_KEY=

# IP/Domain Enrichment
CTI_GREYNOISE_API_KEY=
CTI_URLSCAN_API_KEY=
CTI_ABUSEIPDB_API_KEY=

# Infrastructure Discovery
CTI_CENSYS_API_ID=
CTI_CENSYS_API_SECRET=
CTI_SHODAN_API_KEY=

# CVE Enrichment (planned)
CTI_NVD_API_KEY=
CTI_GITHUB_TOKEN=

# Threat Intelligence Platforms (planned)
CTI_MISP_API_KEY=
CTI_OPENCTI_API_KEY=
CTI_TAXII_USERNAME=
CTI_TAXII_PASSWORD=
CTI_TAXII_COLLECTION_URL=

# SIEM/SOAR Integrations (planned)
CTI_SENTINEL_WORKSPACE_ID=
CTI_SENTINEL_API_KEY=
CTI_SPLUNK_URL=
CTI_SPLUNK_TOKEN=
CTI_ELASTIC_URL=
CTI_ELASTIC_API_KEY=

# Case Management (planned)
CTI_THEHIVE_URL=
CTI_THEHIVE_API_KEY=
CTI_CORTEX_URL=
CTI_CORTEX_API_KEY=

# Social Media Collectors (planned)
CTI_REDDIT_CLIENT_ID=
CTI_REDDIT_CLIENT_SECRET=
CTI_TWITTER_BEARER_TOKEN=
CTI_BLUESKY_HANDLE=
CTI_BLUESKY_PASSWORD=
CTI_MASTODON_INSTANCE=
CTI_MASTODON_TOKEN=

# Feedly Threat Intelligence
CTI_FEEDLY_API_TOKEN=
CTI_FEEDLY_USER_ID=

# --- Optional alert channels ---
CTI_SLACK_WEBHOOK_URL=
CTI_TEAMS_WEBHOOK_URL=
CTI_ALERT_EMAIL_FROM=
CTI_ALERT_EMAIL_TO=

# --- Retention (days) ---
CTI_RETENTION_RAW_HTML_DAYS=14
CTI_RETENTION_ARTICLE_TEXT_DAYS=365
